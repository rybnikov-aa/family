# Deployment configuration for family.rybnikov.su
# Copy this file to `.env` and adjust values. `.env` is loaded automatically
# by `npm run deploy` (scripts/deploy.mjs) and is gitignored.

DEPLOY_HOST=family.rybnikov.su   # SSH host
DEPLOY_USER=rybnikov             # SSH user
DEPLOY_PORT=22                   # SSH port
DEPLOY_FRONTEND_DIR=/var/www/family.rybnikov.su/public_html
DEPLOY_BACKEND_DIR=/var/www/family.rybnikov.su/server
DEPLOY_PM2_APP=family-backend    # pm2 app name

# Optional: prepare the server for PDF import («Ремонт»): install python3-venv
# (via passwordless sudo), create ~/renov-venv with pdfplumber and write
# RENOVATION_PYTHON / RENOVATION_EXTRACT_SCRIPT into server/.env if absent.
# Idempotent and non-fatal. Disable with DEPLOY_PDF_SETUP=0 (or --no-pdf-setup).
# DEPLOY_PDF_SETUP=1

# Optional: bin directory with node/npm ON THE SERVER, used if the remote
# script cannot auto-detect them (e.g. /home/rybnikov/.nvm/versions/node/v24.19.0/bin)
# DEPLOY_NODE_PATH=
