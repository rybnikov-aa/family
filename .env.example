# Deployment configuration for my.rybnikov.su (основной хост)
# Copy this file to `.env` and adjust values. `.env` is loaded automatically
# by `npm run deploy` (scripts/deploy.mjs) and is gitignored.

DEPLOY_HOST=my.rybnikov.su   # SSH host
DEPLOY_USER=rybnikov         # SSH user
DEPLOY_PORT=22               # SSH port
DEPLOY_FRONTEND_DIR=/var/www/my.rybnikov.su/public_html
DEPLOY_BACKEND_DIR=/var/www/my.rybnikov.su/server
DEPLOY_PM2_APP=family-backend    # pm2 app name
# Абсолютный PM2_HOME на сервере (стабильный путь для pm2-демона).
# Обязательно: Windows-ssh шлёт HOME=C:Usersalex, и без PM2_HOME демон нестабилен.
DEPLOY_PM2_HOME=/home/rybnikov/.pm2

# Optional: prepare the server for PDF import («Ремонт»): install python3-venv
# (via passwordless sudo), create ~/renov-venv with pdfplumber and write
# RENOVATION_PYTHON / RENOVATION_EXTRACT_SCRIPT into server/.env if absent.
# Idempotent and non-fatal. Disable with DEPLOY_PDF_SETUP=0 (or --no-pdf-setup).
# DEPLOY_PDF_SETUP=1

# Optional: bin directory with node/npm ON THE SERVER, used if the remote
# script cannot auto-detect them (на текущих хостах node уже в PATH: /usr/bin)
# DEPLOY_NODE_PATH=

# Пошаговая публикация: тестовый сервер -> копирование данных -> sanity-тесты -> основной сервер.
# По умолчанию создаются временные пользователи test/test123456 (admin) и user/user123456 (user).
# Для pipeline credentials можно переопределить переменные ниже; после sanity пользователи удаляются.
# Копирование docs/images с основного сервера включается явно: PIPELINE_SYNC_FILES=1.
# PIPELINE_TEST_ADMIN_USERNAME=test
# PIPELINE_TEST_ADMIN_PASSWORD=test123456
# PIPELINE_TEST_USER_USERNAME=user
# PIPELINE_TEST_USER_PASSWORD=user123456
# PIPELINE_SYNC_FILES=0
# PIPELINE_TEST_URL=https://test.rybnikov.su

# Расширенная настройка pipeline (дефолты подходят для текущих хостов; задавать только при
# отличиях путей/хостов):
# source (источник данных, основной): PIPELINE_SOURCE_HOST/USER/PORT/BACKEND_DIR
# target (тестовый):                  PIPELINE_TARGET_HOST/USER/PORT/FRONTEND_DIR/BACKEND_DIR/PM2_APP/PM2_HOME
# main (основной, цель деплоя):        PIPELINE_MAIN_HOST/USER/PORT/FRONTEND_DIR/BACKEND_DIR/PM2_APP/PM2_HOME
# SANITY-тесты (npm run sanity:test) читают: SANITY_BASE_URL, SANITY_USERNAME, SANITY_PASSWORD.

# ── Бэкап и восстановление (scripts/backup.mjs, scripts/restore.mjs) ─────────────────
# backup: архив на сервере + (по умолчанию) скачивание в локальную папку; ротация на сервере.
# BACKUP_SERVER_DIR=/var/backups/family   # каталог архивов на сервере
# BACKUP_LOCAL_DIR=backups                # локальная папка для скачивания (npm run backup)
# BACKUP_KEEP=7                           # сколько последних архивов хранить на сервере
# BACKUP_CRON_TIME=0 3 * * *              # расписание cron-бэкапа (--install-cron, время сервера)
#
# restore: цель задаётся отдельным пространством имён RESTORE_* (DEPLOY_* описывает основной
# хост и к цели восстановления по умолчанию НЕ применяется). DEPLOY_HOST обязателен.
# RESTORE_USER=rybnikov
# RESTORE_PORT=22
# RESTORE_BACKEND_DIR=/var/www/<host>/server
# RESTORE_PM2_APP=family-backend
# RESTORE_PM2_HOME=/home/rybnikov/.pm2
