# Server port
PORT=3000

# Allowed CORS origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# SQLite database path (relative to backend/). Runtime data, not in git.
DB_PATH=data/vps.sqlite

# Projects root: subfolders with index.html become projects in the «Проекты» section.
# Project pages are served at /projects/<slug>/ (deploy mirrors the repo's
# projects/ folder into public_html/projects/ 1:1). Default is
# '../public_html/projects' (works in production where backend/ and public_html/
# are siblings). For local dev, point it at the repo's projects/ folder, e.g.:
PROJECTS_DIR=../public_html/projects
# PROJECTS_DIR=../projects

# ── Авторизация ───────────────────────────────────────────────────────────────
# Имя cookie сессии (httpOnly, SameSite=Lax). По умолчанию: sid
# AUTH_COOKIE_NAME=sid

# Срок жизни сессии в часах. По умолчанию: 168 (7 суток)
# SESSION_TTL_HOURS=168

# Bootstrap администратора: если в БД нет ни одного пользователя, при старте
# создаётся учётка `admin` с этим паролем (роль admin). После первого входа
# переменную можно убрать; дальнейшие учётки — через `npm run user -w backend`.
# ВАЖНО: задаётся один раз; в прод-`.env` держите только при первичном запуске.
# AUTH_BOOTSTRAP_PASSWORD=
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_NAME=Администратор
