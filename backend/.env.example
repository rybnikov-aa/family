# Server port
PORT=3000

# Allowed CORS origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# SQLite paths (relative to backend/). Runtime data, not in git. Each domain has
# its own DB file: VPS, авторизация (users+sessions), прикладные проекты
# (kind: 'app') и модуль «Ремонт» — независимые базы.
DB_PATH=data/vps.sqlite
# AUTH_DB_PATH=data/auth.sqlite
# PROJECTS_DB_PATH=data/projects.sqlite

# ── Модуль «Ремонт» (renovation) ──────────────────────────────────────────────
# Отдельная БД отчётности ремонта (не трогает DB_PATH — это базы разных модулей).
# По умолчанию: data/renovation.sqlite рядом с backend/. Наполняется штатно — через
# импорт PDF в приложении (POST /api/renovation/pdf); seed из статичных HTML больше нет.
# RENOVATION_DB_PATH=data/renovation.sqlite

# Каталог сохранения загруженных PDF «Ремонта» (импорт PDF). По умолчанию docs/renovation
# относительно CWD бэкенда: dev — backend/docs/renovation, сервер — server/docs/renovation
# (каталог сохраняется при деплое, как data/).
# RENOVATION_DOCS_DIR=docs/renovation

# Импорт PDF (этап 3): интерпретатор Python с pdfplumber и путь к extract_pdf.py.
# По умолчанию — локальный venv с pdfplumber (путь зависит от ОС: Windows —
# ../.venv/Scripts/python.exe, Debian/Ubuntu — ../.venv/bin/python) и скрипт
# scripts/extract_pdf.py. На сервере python с pdfplumber ставится отдельно и путь
# задаётся явно (см. docs/server.md).
# RENOVATION_PYTHON=/home/rybnikov/renov-venv/bin/python
# RENOVATION_EXTRACT_SCRIPT=/var/www/family.rybnikov.su/server/scripts/extract_pdf.py

# ── Авторизация ───────────────────────────────────────────────────────────────
# Имя cookie сессии (httpOnly, SameSite=Lax). По умолчанию: sid
# AUTH_COOKIE_NAME=sid

# Срок жизни сессии в часах. По умолчанию: 168 (7 суток)
# SESSION_TTL_HOURS=168

# Bootstrap администратора: если в БД нет ни одного пользователя, при старте
# создаётся учётка `admin` с этим паролем (роль admin). После первого входа
# переменную можно убрать; дальнейшие учётки — через `npm run user -w backend`.
# ВАЖНО: задаётся один раз; в прод-`.env` держите только при первичном запуске.
# AUTH_BOOTSTRAP_PASSWORD=
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_NAME=Администратор
